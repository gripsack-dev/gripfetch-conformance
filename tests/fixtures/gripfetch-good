#!/usr/bin/env python3
"""A contract-conforming fixture plugin."""
import json, os, sys

request = json.loads(sys.stdin.readline())
dest = request["dest_dir"]
args = request.get("args", {})
os.makedirs(dest, exist_ok=True)

if args.get("verbose_stderr_lines"):
    for i in range(args["verbose_stderr_lines"]):
        sys.stderr.write(f"chatter {i}\n")

if args.get("package") == "does-not-exist-404":
    print(json.dumps({"type": "diagnostic", "diagnostic": {
        "code": "A01", "severity": "error",
        "message": "artifact does-not-exist-404 not found", "labels": [],
        "help": "check the package name"}}))
    print(json.dumps({"type": "response", "id": 1, "result": {}}))
    sys.exit(1)

with open(os.path.join(dest, "probe"), "w") as f:
    f.write("conformance-payload\n")

print(json.dumps({"type": "response", "id": 1, "result": {
    "provenance": {"registry": "conformance-fixture", "artifact": "probe/1.0.0"}}}))
